# ========================================================
# FarmShield Backend API - Render Environment Variables
# Root Folder on Render: web/backend/
# ========================================================

# Application Mode & Port
NODE_ENV=production
PORT=10000

# CORS & Frontend Origins (Allow your Vercel deployment URL or '*' for all)
CORS_ORIGIN=*
FRONTEND_URL=https://your-farmshield-app.vercel.app

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://dykjepfsrndzamkkzcxf.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ML Microservice URL (Optional, defaults to internal fallback)
# ML_SERVICE_URL=http://localhost:8000
